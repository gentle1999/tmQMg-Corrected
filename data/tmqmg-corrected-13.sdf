>  <SOURCE_REFERENCES>
["https://github.com/jensengroup/xyz2mol_tm/tree/db2734b084045ef895528c7a3d5040d38da23983/SMILES_csvs","https://github.com/uiocompcat/tmQM/tree/ece824419c9006fe66436daf233822b75533b82f/tmQM"]

